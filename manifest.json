{
  "manifest_version": 3,
  "name": "DarkSnowF - Pagina de inicio personalizada",
  "short_name": "DarkSnowF",
  "version": "1.0",
  "version_name": "1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "darksnowf@freezeezy.peak",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "description": "Convierte tu pagina de nueva pestana en DarkSnowF: buscador multi-motor, accesos rapidos, reloj, fondos y temas personalizables.",
  "icons": {
    "16": "assets/Texturas/Logos/DarkSnowF-16.png",
    "48": "assets/Texturas/Logos/DarkSnowF-48.png",
    "128": "assets/Texturas/Logos/DarkSnowF-128.png"
  },
  "action": {
    "default_title": "Abrir DarkSnowF",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/Texturas/Logos/DarkSnowF-16.png",
      "48": "assets/Texturas/Logos/DarkSnowF-48.png",
      "128": "assets/Texturas/Logos/DarkSnowF-128.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "Index.html"
  },
  "options_page": "pages/config.html",
  "background": {
    "service_worker": "src/js/background.js"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.google.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: https:; media-src 'self' data: https:; connect-src 'self' https:; font-src 'self' data:;"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "themes/*",
        "src/css/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
